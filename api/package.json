{
  "name": "@astrofork/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/worker.ts --bundle --format=esm --target=es2020 --outfile=dist/worker.js --external:pg --external:drizzle-orm",
    "start": "node dist/index.js",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.2",
    "cosmi": "^0.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.6.14",
    "lru-cache": "^11.0.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "esbuild": "^0.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^3.112.0"
  }
}